<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep navy gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#071018"
                android:centerColor="#0D1B2A"
                android:endColor="#111E2E"
                android:angle="0" />
        </shape>
    </item>

    <!-- Subtle top highlight line -->
    <item
        android:bottom="155dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D00E5FF" />
        </shape>
    </item>

    <!-- Cyan accent vertical bar (left edge) -->
    <item
        android:right="304dp"
        android:top="18dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#00E5FF" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Play button: outer glow circle -->
    <item
        android:left="18dp"
        android:top="28dp"
        android:right="228dp"
        android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#0D00E5FF" />
        </shape>
    </item>

    <!-- Play button: circle ring -->
    <item
        android:left="22dp"
        android:top="32dp"
        android:right="232dp"
        android:bottom="32dp">
        <shape android:shape="oval">
            <solid android:color="#1A2B3C" />
            <stroke
                android:width="2dp"
                android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Play triangle (approximated as a rotated rectangle cutout) -->
    <item
        android:left="38dp"
        android:top="48dp"
        android:right="252dp"
        android:bottom="48dp">
        <shape android:shape="rectangle">
            <solid android:color="#00E5FF" />
        </shape>
    </item>

</layer-list>
